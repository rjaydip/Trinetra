# Trinetra Federation API — full environment reference for the container image.
#
#   cp deploy/docker/api.env.example api.env      # then edit
#   docker run --rm -p 5261:8080 --env-file api.env trinetra-api
#
# EVERY value in config/trinetra.settings.json can be set here. A double underscore is a nested
# key (Auth__Jwt__SigningKey -> Auth:Jwt:SigningKey); an array index is a trailing __0, __1, ...
# Anything left unset falls back to the value baked from config/trinetra.settings.example.json,
# whose defaults are shown in [brackets] below.
#
# The container does NOT touch the database schema. Point ConnectionStrings__Federation at a
# database that already has the schema (db/full-schema.sql for a fresh one, or db/versions/*.sql
# applied in order). On start the API verifies it can reach that schema and creates the one
# bootstrap admin row if it is missing — nothing else.
#
# ── REQUIRED (the container will not start without these) ──
#   ConnectionStrings__Federation     baked default points at 127.0.0.1 = the container itself
#   Secrets__Key                      baked CHANGE_ME is not a valid key AND is refused in Production
#   Auth__Jwt__SigningKey             (or Auth__Jwt__SigningKeys__0__Kid + __0__Value) — same
#   Auth__SeedAdmin__Password         baked CHANGE_ME fails the 12-char minimum AND is refused in Production
#
# ── OPTIONAL (baked defaults are valid) ──
#   everything else below — port, issuer/audience, token lifetimes, seed-admin username,
#   retention periods, proxy settings. Auth__AllowedOrigins__* is not a start requirement but a
#   browser UI cannot call the API until at least one origin is listed.


# ── Where the API listens ────────────────────────────────────────────────────
# Port INSIDE the container. Publish it to the host with `-p <host>:<this>`.
ASPNETCORE_HTTP_PORTS=8080
# Or bind explicitly (overrides ASPNETCORE_HTTP_PORTS); use for a non-default bind address.
# ASPNETCORE_URLS=http://0.0.0.0:8080

# Leave as Production. Development relaxes the committed-secret guard and CORS.
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production


# ── Database — REQUIRED ──────────────────────────────────────────────────────
# The API connects here and runs against whatever is on the other end. It never migrates it.
# Keep the pool sizing rule: (api instances x Max Pool Size) + (workers x pool) < postgres max_connections
ConnectionStrings__Federation=Host=127.0.0.1;Port=55432;Database=trinetra;Username=trinetra;Password=trinetra;Maximum Pool Size=40;Minimum Pool Size=2;Timeout=10;Command Timeout=30;Keepalive=30;Application Name=trinetra-api

# ── Credential sealing — REQUIRED in Production ──────────────────────────────
# AES key that encrypts every camera password before it reaches PostgreSQL.
#   openssl rand -base64 32
# NEVER change once any credential is stored — every stored password becomes unreadable.
# KeyId records which key sealed each secret, so rotation can be staged.
Secrets__KeyId=prod-key-1
Secrets__Key=//dOTpBsLPDXhRwsK5vEhe9GL+onp0yIRju6X85v0Ts=

# ── JWT / sessions — SigningKey REQUIRED in Production ───────────────────────
# Single key (simplest):
#   openssl rand -base64 48
Auth__Jwt__SigningKey=Llg9ZNHCqJaHu6zAxnr5vyZdSKlKZO0o5KUnXR7hhraAm7ZYTQjqpNSKdAJSKrnu
# Or a rotation ring — first entry signs, every entry validates (drop SigningKey if you use this):
#   Auth__Jwt__SigningKeys__0__Kid=2026-q1
#   Auth__Jwt__SigningKeys__0__Value=<base64, >=32 bytes>
#   Auth__Jwt__SigningKeys__1__Kid=2025-q4
#   Auth__Jwt__SigningKeys__1__Value=<old key, still valid>
#
Auth__Jwt__Issuer=trinetra
Auth__Jwt__Audience=trinetra-api
Auth__Jwt__AccessLifetime=00:15:00
Auth__Jwt__RefreshLifetime=08:00:00
Auth__Jwt__RefreshReuseGrace=00:00:10


# ── Bootstrap admin — Password REQUIRED ────────────────────────────────────
# Created once, on first start, only if the account is absent. Must be rotated at first login;
# after that, drop Auth__SeedAdmin__Password so no deployment carries it.
Auth__SeedAdmin__Username=admin
Auth__SeedAdmin__Password=ChangeMe!Bootstrap2026
Auth__SeedAdmin__DisplayName=Platform Administrator


# ── CORS — origins allowed to call the API (never "*") ──────────────────────
Auth__AllowedOrigins__0=https://console.example.gov
# Auth__AllowedOrigins__1=https://ops.example.gov


# ── Reverse proxy ──────────────────────────────────────────────────────────
# Turn on ONLY behind a proxy AND list it — enabling without KnownProxies/KnownNetworks lets any
# client spoof X-Forwarded-For and silently defeats rate limiting. Startup refuses that combo.
Network__TrustForwardedHeaders=false
# Network__KnownProxies__0=10.0.0.5
# Network__KnownNetworks__0=10.0.0.0/8


# ── Retention (days unless noted; minimum 7; partitions DROPPED daily, irreversibly) ──
# A POLICY decision — confirm against the retention rules this deployment is bound by.
Retention__Enabled=true
Retention__RunAtUtcHour=3
Retention__EventDays=90
Retention__HealthDays=30
Retention__CameraStatusDays=90
Retention__ConnectionTestDays=30
Retention__DeadLetterDays=90
Retention__AuditMonths=84
Retention__AuthAuditMonths=24
