# Trinetra streaming gateway path provisioner — environment reference.
#
#   cp deploy/mediamtx/mediamtx-provisioner.env.example /etc/trinetra/mediamtx-provisioner.env
#   chmod 600 /etc/trinetra/mediamtx-provisioner.env   # then edit — it holds an API key
#
# ── REQUIRED ──

# Base URL of Federation.Api, reachable from this host. Must be the same host/port the
# STREAMING_GATEWAY API key below was issued against.
TRINETRA_API_BASE_URL=https://127.0.0.1:5261

# API key for an access group holding ONLY the STREAMING_GATEWAY machine role — never a
# human account's key, never DETECTION_WORKER's. See docs/STREAMING-GATEWAY-PLAN.md §5 for why
# this role is deliberately narrow (camera.credential.resolve + read scope only, nothing that
# can write observations or anything else into the platform).
TRINETRA_API_KEY=

# ── OPTIONAL (defaults shown) ──

# MediaMTX's own runtime config API — loopback only, matching mediamtx.yml's apiAddress.
MEDIAMTX_API_URL=http://127.0.0.1:9997

# How often the full camera list is re-walked and MediaMTX's paths reconciled against it.
PROVISION_INTERVAL_SECONDS=60

PROVISION_HTTP_TIMEOUT_SECONDS=15
