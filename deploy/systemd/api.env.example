# /etc/trinetra/api.env      root:trinetra  0640
#
# Secrets belong here, not in config/trinetra.settings.json. That file is committed, and a unit
# file is world-readable and appears in `systemctl cat` output and in configuration management.
#
# A double underscore is a nested configuration key: Auth__Jwt__SigningKey sets Auth:Jwt:SigningKey.

# Where the API listens. Bind to localhost when a reverse proxy fronts it; see Network settings
# in config/trinetra.settings.json before exposing it directly.
ASPNETCORE_URLS=http://127.0.0.1:5261

ConnectionStrings__Federation=Host=db.internal;Port=5432;Database=trinetra;Username=trinetra;Password=CHANGE_ME;Maximum Pool Size=40;Minimum Pool Size=2;Timeout=10;Command Timeout=30;Keepalive=30;Application Name=trinetra-api

# openssl rand -base64 32
#
# NEVER change this once credentials are stored: every stored camera password becomes permanently
# unreadable and must be re-entered by hand across the whole estate. Secrets__KeyId records which
# key sealed each secret, so rotation can be staged rather than done as a flag day.
Secrets__KeyId=prod-key-1
Secrets__Key=CHANGE_ME

# openssl rand -base64 48
# A leaked signing key lets anyone forge a session as any user, including the administrator.
# Rotating it invalidates every issued token, which is a blunt but effective way to force
# everyone to log in again.
Auth__Jwt__SigningKey=CHANGE_ME

# Bootstrap only. Created on first start, never updated afterwards, and the account must rotate
# it at first login. Remove this line once that has happened.
Auth__SeedAdmin__Password=CHANGE_ME
