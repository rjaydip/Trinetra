# /etc/trinetra/worker.env      root:trinetra  0640
#
# The worker needs the same database and the same encryption key as the API. A worker whose
# Secrets__Key differs cannot decrypt the credentials the API stored, and reports it as
# corruption rather than as misconfiguration.

ConnectionStrings__Federation=Host=db.internal;Port=5432;Database=trinetra;Username=trinetra;Password=CHANGE_ME;Maximum Pool Size=10;Minimum Pool Size=1;Timeout=10;Command Timeout=30;Keepalive=30;Application Name=trinetra-worker

Secrets__KeyId=prod-key-1
Secrets__Key=CHANGE_ME

# Targets one worker process will hold. Caps blast radius: without a bound, whichever worker
# starts first claims the entire estate and its failure becomes a total outage instead of a
# partial one. Fleet capacity is (instances x MaxTargets), so size it against the VMS count.
Worker__MaxTargets=100

# Worker__WorkerId is set by the unit file from the hostname and instance number. Do not set it
# here: every instance would share one identity and they would fight over the same leases.
