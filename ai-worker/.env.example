# Copy to .env (gitignored) and adjust. Every value here has a code default in config.py;
# this file exists to make the knobs discoverable, not because all of them must be set.

# --- Per-stage backend selection: local | remote (vehicle/ocr), local | remote | heuristic (plate)
VEHICLE_BACKEND=local
PLATE_BACKEND=heuristic
OCR_BACKEND=local

# --- Local model weights ---------------------------------------------------------------------
VEHICLE_MODEL_PATH=yolov8n.pt
# PLATE_MODEL_PATH=                     # required only when PLATE_BACKEND=local
DEVICE=cpu                              # cpu | cuda | mps

# --- RTSP credentials -----------------------------------------------------------------------
# Cameras discovered via CAMERA_SOURCE=trinetra arrive as credential-free rtsp:// URLs (the
# registry never returns secrets). Set these when the camera requires auth; they are injected
# at connect time, kept in memory, and redacted from logs. A URL that already embeds
# user:pass@ (e.g. in cameras.yaml) is left as-is.
# RTSP_USERNAME=
# RTSP_PASSWORD=

# --- Remote AI API (only used by the stages set to "remote") ---------------------------------
# VEHICLE_API_URL=https://your-vision-api.example.com/detect
# VEHICLE_API_KEY=
# PLATE_API_URL=
# PLATE_API_KEY=
# OCR_API_URL=
# OCR_API_KEY=
REMOTE_API_TIMEOUT_SECONDS=10

# --- Confidence thresholds (brief §37) ---------------------------------------------------------
VEHICLE_CONFIDENCE_THRESHOLD=0.5
PLATE_CONFIDENCE_THRESHOLD=0.4
OCR_CONFIDENCE_THRESHOLD=0.5

# --- Frame sampling --------------------------------------------------------------------------
PROCESSING_FPS=2

# --- Capture backend: opencv (default, pip-only) | ffmpeg | gstreamer | deepstream ------------
# All four read the same rtsp:// URL; opencv/ffmpeg/gstreamer are verified against a real RTSP
# stream, deepstream needs an NVIDIA GPU + SDK and cannot run/be verified on this machine.
CAPTURE_BACKEND=opencv

# --- Horizontal scaling (static partitioning — see scaling.py) -------------------------------
WORKER_INDEX=0
WORKER_COUNT=1

# --- Camera source: trinetra (Federation.Api, default) or static (local YAML, dev/offline) ----
CAMERA_SOURCE=trinetra
CAMERAS_CONFIG_PATH=cameras.yaml          # only read when CAMERA_SOURCE=static

# --- Trinetra Federation.Api --------------------------------------------------------------
# Camera discovery (GET /api/v1/vms, GET /api/v1/vms/{id}/cameras — the platform's own camera
# registry) and, once it exists, detection ingest (POST /api/v1/detections — Phase 2). No
# default in config.py by design — this is deployment configuration, not something to bake
# into source. TRINETRA_API_KEY is an X-Api-Key value for a service integration (see the
# platform's own docs on api_key/access_groups) — a person would use a Bearer login token
# instead, but this worker is an unattended process.
TRINETRA_API_BASE_URL=http://192.168.1.11:5261
TRINETRA_API_KEY=887220c6a4532a07ec9422b543308c14854c02b48f4af93ee179afd14200e1da
BACKEND_INGEST_URL=http://192.168.1.11:5261/api/v1/detections
BACKEND_HEARTBEAT_URL=http://192.168.1.11:5261/api/v1/worker-health/heartbeat
BACKEND_HEARTBEAT_INTERVAL_SECONDS=15

# --- Monitoring --------------------------------------------------------------------------------
METRICS_HOST=0.0.0.0
METRICS_PORT=8000

# --- Evidence ------------------------------------------------------------------------------------
EVIDENCE_DIR=evidence

# --- Logging ------------------------------------------------------------------------------------
# DEBUG prints the per-stage pipeline trace: "N vehicle region(s) -> M plate candidate(s) ->
# OCR 'text' (conf) -> 'normalized'" — the fastest way to see which stage is dropping a plate.
# LOG_LEVEL=DEBUG
