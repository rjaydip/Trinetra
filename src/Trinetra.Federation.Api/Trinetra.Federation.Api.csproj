<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <ProjectReference Include="..\Trinetra.Federation.Core\Trinetra.Federation.Core.csproj" />
    <ProjectReference Include="..\Trinetra.Federation.Storage\Trinetra.Federation.Storage.csproj" />
    <ProjectReference Include="..\Trinetra.Federation.Bus\Trinetra.Federation.Bus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trinetra.Federation.Runtime\Trinetra.Federation.Runtime.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <!-- One shared settings file, linked rather than duplicated. Three copies of the credential
       encryption key would eventually diverge, and the resulting failure looks like data
       corruption rather than like configuration drift. -->
  <ItemGroup>
    <Content Include="../../config/trinetra.settings.json" Link="trinetra.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The integration tests call a few endpoint handlers directly (auth: refresh / logout /
         password), which need a live pipeline to reach over HTTP but are plain static methods
         otherwise. The unit tests cover the pure auth helpers (API-key format check, the
         fixed-window limiter). Nothing else is exposed. -->
    <InternalsVisibleTo Include="Trinetra.IntegrationTests" />
    <InternalsVisibleTo Include="Trinetra.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- sd_notify support. Without it a Type=notify unit waits for a readiness signal that never
         arrives and systemd kills the service at TimeoutStartSec. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
  </ItemGroup>

</Project>
